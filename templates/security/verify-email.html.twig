{% extends 'base.html.twig' %}

{% block title %}Vérification de l'adresse e-mail{% endblock %}

{% block body %}
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-md rounded-lg border bg-card p-8 shadow-sm text-center space-y-4">
            {% if success %}
                <div class="text-4xl">✅</div>
                <h1 class="text-xl font-semibold">Adresse e-mail vérifiée !</h1>
                <p class="text-sm text-muted-foreground">Votre compte est maintenant actif. Vous pouvez vous connecter.</p>
            {% else %}
                <div class="text-4xl">❌</div>
                <h1 class="text-xl font-semibold">Lien invalide ou expiré</h1>
                <p class="text-sm text-muted-foreground">Ce lien de vérification n'est pas valide ou a déjà été utilisé.</p>
            {% endif %}
            <a href="{{ loginUrl }}" class="inline-block mt-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
                Aller à la connexion
            </a>
        </div>
    </div>
{% endblock %}
