<header class="sticky top-0 z-50 border-b border-border/50 bg-background/80 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="flex h-16 items-center gap-6">

            {# ── Logo ── #}
            <a href="{{ path('app_home') }}"
               class="flex items-center gap-2.5 shrink-0 font-semibold text-foreground hover:opacity-75 transition-opacity">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground text-sm font-black shadow-sm">
                    B
                </div>
                <span class="text-[15px] tracking-tight">BleuMont</span>
            </a>

            {# ── Séparateur vertical ── #}
            <div class="hidden md:block h-5 w-px bg-border shrink-0"></div>

            {# ── Liens de navigation ── #}
            <nav class="hidden md:flex items-center gap-0.5 flex-1">
                {% set route = app.request.attributes.get('_route') %}
                <a href="{{ path('app_home') }}"
                   class="relative px-3 py-1.5 text-sm rounded-md transition-colors
                          {% if route == 'app_home' %}font-medium text-foreground{% else %}text-muted-foreground hover:text-foreground hover:bg-accent{% endif %}">
                    Accueil
                    {% if route == 'app_home' %}
                        <span class="absolute inset-x-3 -bottom-px h-px bg-primary"></span>
                    {% endif %}
                </a>
                <a href="{{ path('blog_index') }}"
                   class="relative px-3 py-1.5 text-sm rounded-md transition-colors
                          {% if route starts with 'blog' %}font-medium text-foreground{% else %}text-muted-foreground hover:text-foreground hover:bg-accent{% endif %}">
                    Blog
                    {% if route starts with 'blog' %}
                        <span class="absolute inset-x-3 -bottom-px h-px bg-primary"></span>
                    {% endif %}
                </a>
                <a href="{{ path('shop_index') }}"
                   class="relative px-3 py-1.5 text-sm rounded-md transition-colors
                          {% if route starts with 'shop' %}font-medium text-foreground{% else %}text-muted-foreground hover:text-foreground hover:bg-accent{% endif %}">
                    Boutique
                    {% if route starts with 'shop' %}
                        <span class="absolute inset-x-3 -bottom-px h-px bg-primary"></span>
                    {% endif %}
                </a>
            </nav>

            {# ── Actions utilisateur (poussées à droite) ── #}
            <div class="flex items-center gap-2 ml-auto">
                {% if app.user %}
                    {# Email tronqué #}
                    <span class="hidden lg:flex items-center gap-1.5 text-sm text-muted-foreground">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-muted text-xs font-medium text-foreground shrink-0">
                            {{ app.user.userIdentifier|slice(0,1)|upper }}
                        </span>
                        <span class="truncate max-w-[140px]">{{ app.user.userIdentifier }}</span>
                    </span>

                    {# Lien Administration #}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}"
                           class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md bg-secondary text-secondary-foreground hover:bg-secondary/70 transition-colors">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            Admin
                        </a>
                    {% endif %}

                    {# Déconnexion #}
                    <a href="{{ path('app_security_logout') }}"
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md border border-border text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                        </svg>
                        Déconnexion
                    </a>

                {% else %}
                    <a href="{{ path('app_security_login') }}"
                       class="px-3 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md hover:bg-accent">
                        Connexion
                    </a>
                    <a href="{{ path('app_security_register') }}"
                       class="inline-flex items-center px-4 py-1.5 text-sm font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors shadow-sm">
                        Créer un compte
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</header>
